# Keep repository text files stable across Windows, macOS, and Linux.
* text=auto eol=lf

# Explicit source and project configuration rules.
*.py text eol=lf
*.pyi text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.css text eol=lf
*.html text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf

# Never apply line-ending conversion to binary assets.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
