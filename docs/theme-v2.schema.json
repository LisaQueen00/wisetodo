  "required": [
    "schemaVersion",
    "name"
  ],
  "$defs": {
    "background": {
      "oneOf": [
        {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "ref": {
                  "type": "string",
                  "description": "引用 palette 中已定义的名称"
                }
              },
              "required": [
                "ref"
              ]
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "linear"
            },
            "angle": {
              "type": "number",
              "minimum": 0,
              "maximum": 360
            },
            "stops": {
              "type": "array",
              "minItems": 2,
              "maxItems": 12,
              "description": "按 position 升序；运行时检查排序与引用",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "color": {
                    "oneOf": [
                      {
                        "type": "string",
                        "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "ref": {
                            "type": "string",
                            "description": "引用 palette 中已定义的名称"
                          }
                        },
                        "required": [
                          "ref"
                        ]
                      }
                    ]
                  },
                  "position": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  }
                },
                "required": [
                  "color",
                  "position"
                ]
              }
            }
          },
          "required": [
            "type",
            "stops"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "radial"
            },
            "stops": {
              "type": "array",
              "minItems": 2,
              "maxItems": 12,
              "description": "按 position 升序；运行时检查排序与引用",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "color": {
                    "oneOf": [
                      {
                        "type": "string",
                        "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "ref": {
                            "type": "string",
                            "description": "引用 palette 中已定义的名称"
                          }
                        },
                        "required": [
                          "ref"
                        ]
                      }
                    ]
                  },
                  "position": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  }
                },
                "required": [
                  "color",
                  "position"
                ]
              }
            }
          },
          "required": [
            "type",
            "stops"
          ]
        }
      ]
    },
    "text": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ref": {
